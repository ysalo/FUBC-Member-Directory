    "Ask the church office for account approval, a directory correction, or removal of your information. Never send a password or login code.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask the church office for account approval, a directory correction, or removal of your information. Never send a password or login code."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зверніться до церковної канцелярії, щоб підтвердити доступ, виправити або видалити ваші дані. Ніколи не надсилайте пароль чи код входу."
          }
        }
      }
    },
